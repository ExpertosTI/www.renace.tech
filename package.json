{
  "name": "renace-tech",
  "version": "3.0.4",
  "private": true,
  "description": "RENACE.TECH — Platform for business digitalization",
  "author": "RENACE.TECH",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "www:portal": "./scripts/build-portal-www.sh",
    "icons": "./scripts/generate-app-icons.sh",
    "cap:sync": "./scripts/build-portal-www.sh && npx cap sync",
    "mac:pack": "npm run icons && electron-builder --mac dmg zip --arm64 --publish never",
    "mac:pack:intel": "npm run icons && electron-builder --mac dmg zip --x64 --publish never",
    "mac:pack:all": "npm run icons && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "win:pack": "./scripts/vendor-posagent.sh && ./scripts/vendor-vcredist.sh && npm run icons && electron-builder --win nsis zip --x64 --publish never",
    "win:pack:zip": "./scripts/vendor-posagent.sh && ./scripts/vendor-vcredist.sh && npm run icons && electron-builder --win zip --x64 --publish never",
    "win:store": "./scripts/vendor-posagent.sh && ./scripts/vendor-vcredist.sh && npm run icons && electron-builder --win appx --x64 --publish never",
    "electron:dev": "electron electron/main.cjs",
    "postinstall": "node -e \"const fs=require('fs');const {spawnSync}=require('child_process');if(!fs.existsSync('scripts/fix-electron-install.sh'))process.exit(0);const r=spawnSync('./scripts/fix-electron-install.sh',{stdio:'inherit'});process.exit(r.status||0)\"",
    "mac:install": "./scripts/install-mac-app.sh",
    "vendor:posagent": "./scripts/vendor-posagent.sh",
    "vendor:vcredist": "./scripts/vendor-vcredist.sh",
    "android:sync": "npm run cap:sync && npx cap add android 2>/dev/null || true && npx cap sync android && ./scripts/apply-native-user-mode.sh",
    "ios:sync": "npm run cap:sync && npx cap add ios 2>/dev/null || true && npx cap sync ios && ./scripts/apply-native-user-mode.sh",
    "native:user-mode": "./scripts/apply-native-user-mode.sh",
    "android:open": "npm run android:sync && npx cap open android",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "stage:downloads": "./scripts/stage-portal-downloads.sh",
    "desktop:update-manifest": "./scripts/publish-desktop-update.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.2.0",
    "@capacitor/core": "8.2.0",
    "@capacitor/ios": "8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.0",
    "picomatch": "^4.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tech.renace.portal.desktop",
    "productName": "RENACE Portal",
    "directories": {
      "output": "dist-electron"
    },
    "afterPack": "./electron/afterPack.cjs",
    "icon": "build/icon.icns",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": false
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RENACE Portal",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RENACE-Portal-${version}-${os}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/posagent/app",
          "to": "posagent",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "vendor/vcredist/VC_redist.x64.exe",
          "to": "vcredist/VC_redist.x64.exe"
        }
      ]
    },
    "appx": {
      "identityName": "RENACE.TECH.RENACEPortal",
      "publisher": "CN=RENACE.TECH",
      "publisherDisplayName": "RENACE.TECH",
      "applicationId": "RENACEPortal",
      "displayName": "RENACE Portal"
    },
    "dmg": {
      "background": "build/dmg-background.tiff",
      "iconSize": 128,
      "iconTextSize": 14,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 160,
          "y": 205,
          "type": "file"
        },
        {
          "x": 500,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "identity": "ADDERLY MARTE (M5LFB3VWUY)",
      "extendInfo": {
        "CFBundleDisplayName": "RENACE Portal",
        "CFBundleName": "RENACE Portal",
        "CFBundleSpokenName": "RENACE Portal",
        "CFBundleIdentifier": "tech.renace.portal.desktop",
        "LSApplicationCategoryType": "public.app-category.business",
        "NSHumanReadableCopyright": "Copyright © RENACE.TECH",
        "NSHighResolutionCapable": true,
        "NSSupportsAutomaticTermination": false,
        "NSSupportsSuddenTermination": false
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
