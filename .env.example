# Database — host = nombre de servicio Swarm ÚNICO (nunca alias genérico "db")
# renace_app → renace_db / renace_user / renace_db
# Insforge es OTRO stack (insforge_postgres / insforge_admin / insforge) — no mezclar
POSTGRES_USER=renace_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=renace_db
DATABASE_URL=postgresql://renace_user:change_me_in_production@renace_db:5432/renace_db

# App
NEXT_PUBLIC_BASE_URL=https://renace.tech
APP_HOST=renace.tech

# ── Security secrets ──
# Déjalos vacíos o con change_me_*: scripts/ensure-secrets.sh (deploy) y
# lib/secrets-bootstrap.js (arranque) los generan con openssl/crypto y los
# persisten. NO los regenera si ya hay un valor real.
ADMIN_ACCESS_PASSWORD=
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=
PARTICIPANT_SESSION_SECRET=
PORTAL_ENCRYPTION_KEY=
NOTIFY_API_KEY=
SECURITY_STRICT=0
# CORS_EXTRA_ORIGINS=https://staging.renace.tech

# SMTP (Hostinger — práctica oficial)
# host: smtp.hostinger.com
# user/from: info@renace.tech  (deben coincidir)
# pass: contraseña del buzón en hPanel → Emails
# puerto: 465 SSL (preferido) o 587 STARTTLS
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=info@renace.tech
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=RENACE.TECH <info@renace.tech>
MAIL_REPLY_TO=info@renace.tech

# WhatsApp — Evolution API (notificador global)
EVOLUTION_API_URL=https://evoapi.renace.tech
EVOLUTION_API_KEY=your-evolution-global-api-key
EVOLUTION_INSTANCE=RENACE.TECH
WHATSAPP_SENDER_NUMBER=18093487921
WHATSAPP_NOTIFY_NUMBERS=18494577463,18099152622

# Google OAuth (Portal de Clientes) — opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini Copilot (opcional)
GEMINI_API_KEY=

# Odoo Integration
ODOO_URL=http://your-odoo-server:7015
ODOO_LONGPOLL_URL=http://your-odoo-server:7018
ODOO_DB=your-odoo-database
ODOO_API_USER=your-odoo-user@example.com
ODOO_API_KEY=your-odoo-api-key
ODOO_DEFAULT_PARTNER=3

# Admin notification
ADMIN_EMAIL=admin@renace.tech
